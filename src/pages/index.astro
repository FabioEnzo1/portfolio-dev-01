---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Stack from '../components/Stack.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';

const projetos = (await getCollection('projects')).sort((a, b) => a.data.ordem - b.data.ordem);
const [destaque, ...demais] = projetos;
---

<Layout>
  <Hero />

  <section id="projetos" class="mx-auto flex max-w-[1180px] flex-col gap-12 px-8 pt-10 pb-30">
    <div class="flex flex-wrap items-baseline justify-between gap-4 border-t border-line pt-6">
      <h2 class="font-display text-[40px] font-semibold tracking-tight">Projetos selecionados</h2>
      <span class="text-[15px] text-muted">{projetos.length} projetos</span>
    </div>

    {destaque && <ProjectCard projeto={destaque} numero={1} destaque />}

    {demais.length > 0 && (
      <div class="flex flex-wrap gap-8">
        {demais.map((p, i) => <ProjectCard projeto={p} numero={i + 2} />)}
      </div>
    )}
  </section>

  <Stack />
  <About />
  <Contact />
</Layout>
