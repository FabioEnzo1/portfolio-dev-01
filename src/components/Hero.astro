---
import { site } from '../data/site';
---

<section id="topo" class="mx-auto flex max-w-[1180px] flex-wrap items-center gap-14 px-8 pt-20 pb-30">
  <div class="flex min-w-0 flex-[1_1_560px] flex-col gap-7">
    {site.disponivel && (
      <div class="flex items-center gap-2.5 text-sm font-medium text-muted">
        <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
        Disponível para novos projetos
      </div>
    )}
    <h1 class="font-display text-5xl leading-[1.03] font-bold tracking-[-0.035em] md:text-7xl">
      Do banco de dados à interface, eu <span class="text-accent">entrego</span> o produto inteiro.
    </h1>
    <p class="max-w-[560px] text-xl text-muted">
      Me chamo {site.nome}, desenvolvedor full stack em {site.cidade}. Analiso e projeto seu sistema de forma rápida prática e eficiente.
    </p>
    <div class="mt-2 flex flex-wrap gap-4">
      <a
        href="#projetos"
        class="inline-flex items-center gap-2.5 rounded-full bg-accent px-7 py-4 font-semibold text-bg hover:text-bg hover:brightness-110"
      >
        Ver projetos
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a href="#contato" class="inline-flex items-center rounded-full border-[1.5px] border-line-strong px-7 py-4 font-semibold hover:border-accent">
        Falar comigo
      </a>
    </div>
  </div>

  <div class="min-w-0 flex-[1_1_380px] overflow-hidden rounded-[20px] border border-line bg-surface">
    <div class="flex gap-2 border-b border-line px-5 py-4" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-line-strong"></span>
      <span class="h-3 w-3 rounded-full bg-line-strong"></span>
      <span class="h-3 w-3 rounded-full bg-line-strong"></span>
    </div>
    <pre class="overflow-x-auto p-6 font-mono text-sm leading-[1.8] whitespace-pre-wrap text-muted"><code>const dev = &#123;
  nome: "{site.nome}",
  foco: "full stack",
  front: ["React", "Tailwindcss", "Typescript", "Next.Js"],
  back: ["Java", "Node.js", "Javascript", "API Rest" ],
  aprendendo: "Go, Astro e NestJS"
&#125;;</code></pre>
  </div>
</section>
