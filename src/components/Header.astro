---
import { site, nav } from '../data/site';
---

<header class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-4 px-8 py-7">
  <a href="/" class="font-display text-[22px] font-bold tracking-tight hover:text-ink">
    {site.nome}<span class="text-accent">.</span>
  </a>
  <nav class="flex flex-wrap items-center gap-7 text-[15px] font-medium" aria-label="Principal">
    {nav.map((item) => (
      <a href={item.href} class="py-2.5 hover:text-accent">{item.rotulo}</a>
    ))}
    <a
      href="/#contato"
      class="rounded-full bg-ink px-5 py-3 text-bg hover:bg-accent hover:text-bg"
    >
      Contato
    </a>
  </nav>
</header>
