---
import { site } from '../data/site';

const emailLink = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}&su=${encodeURIComponent('Contato pelo portfólio')}&body=${encodeURIComponent('Olá, Fábio! Encontrei seu portfólio e gostaria de conversar com você.')}`;
---

<section id="contato" class="mx-auto max-w-[1180px] px-8 pb-24">
  <div class="flex flex-col items-start gap-7 rounded-[28px] bg-accent px-8 py-16 text-bg md:px-12 md:py-18">
    <h2 class="max-w-[760px] font-display text-4xl leading-[1.08] font-bold tracking-[-0.03em] md:text-6xl">
      Vamos construir algo juntos?
    </h2>
    <p class="max-w-[520px] text-[19px]">Me conte sobre o seu projeto ou vaga. Respondo o mais rápido possível.</p>
    <a
      href={emailLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2.5 rounded-full bg-bg px-7 py-4 font-semibold text-ink hover:text-ink hover:brightness-125"
    >
      {site.email}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
    <ul class="flex flex-wrap gap-7 text-[15px] font-semibold">
      {site.social.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener" class="border-b-[1.5px] border-bg py-2.5 text-bg hover:text-bg hover:opacity-70">
            {s.rotulo}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
